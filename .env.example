# Bot token from https://discord.com/developers/applications (Bot -> Reset Token)
DISCORD_TOKEN=

# Optional: server ID for instant /web registration while testing
GUILD_ID=

# Public HTTPS address of this API. Leave empty to start a free Cloudflare quick tunnel automatically.
PUBLIC_URL=
# auto | off
TUNNEL=auto

# Local port of the API
PORT=8080

# Name of this backend in the dashboard list (e.g. VPS, Home PC)
BACKEND_NAME=

# Where /web points to
DASHBOARD_URL=https://bot.labtoso.de/Msik/
ALLOWED_ORIGINS=https://bot.labtoso.de,https://labtoso.github.io

# Optional: fixed secret so dashboard links survive a restart (only useful together with PUBLIC_URL)
SESSION_SECRET=
SESSION_HOURS=12

DEFAULT_VOLUME=60
IDLE_MINUTES=5
MAX_QUEUE=500

# Optional: Spotify search (switch in the dashboard settings). Free app on https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
