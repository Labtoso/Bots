# Bot token from https://discord.com/developers/applications (Bot -> Reset Token)
DISCORD_TOKEN=

# Optional: server ID for instant command registration while testing
GUILD_ID=

# Public HTTPS address of this API. Leave empty to start a free Cloudflare quick tunnel automatically.
PUBLIC_URL=
# auto | off
TUNNEL=auto

# Local port of the API
PORT=8090

# Name of this backend in the panel list (e.g. VPS, Home PC)
BACKEND_NAME=

# Where /aio points to
DASHBOARD_URL=https://bot.labtoso.de/AIO/
ALLOWED_ORIGINS=https://bot.labtoso.de,https://labtoso.github.io

# Fixed secret so panel links survive a restart (the installer sets one)
SESSION_SECRET=
SESSION_HOURS=12

# Time zone for scheduled messages and birthdays
TZ=Europe/Vienna


# Optional: own Twitch app for live alerts (without it the public channel page is checked)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# 1 = update automatically (Windows: the bot itself, Linux: systemd timer)
AUTO_UPDATE=1
